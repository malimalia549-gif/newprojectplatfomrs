# Optional. Without DATABASE_URL, npm run dev starts a local embedded PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# LOCAL_DB_PORT=55432

# Public origin behind a trusted reverse proxy; do not copy untrusted forwarding headers.
# APP_ORIGIN=https://your-domain.example

# Local HTTP defaults to false. Production defaults to true.
# COOKIE_SECURE=true
# For an HTTPS cross-site embedded preview only; uses Secure + SameSite=None + Partitioned.
# COOKIE_SAMESITE=none

# Test-only browser override; normal users should run npx playwright install chromium.
# CHROMIUM_EXECUTABLE=/path/to/chromium
# TEST_BASE_URL=http://127.0.0.1:3000

# Live trading/payment credentials are deliberately NOT supported by this sandbox.
